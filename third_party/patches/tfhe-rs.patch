diff --git a/backends/tfhe-cuda-backend/cuda/src/utils/fallback_cache.cuh b/backends/tfhe-cuda-backend/cuda/src/utils/fallback_cache.cuh
new file mode 100644
index 000000000..436aa5a69
--- /dev/null
+++ b/backends/tfhe-cuda-backend/cuda/src/utils/fallback_cache.cuh
@@ -0,0 +1,137 @@
+#pragma once
+
+#include <algorithm>
+#include <map>
+#include <mutex>
+#include <vector>
+
+// Opt-in contiguous arena for devices without CUDA memory-pool support.
+// One cudaMalloc reserves the entire arena per device; later allocations
+// are aligned slices or recycled slices. No secret data determines sizes.
+// A release event prevents reuse before the previous stream finishes.
+// The context owns the backing storage until process exit. Exhaustion fails
+// explicitly rather than reintroducing cudaMalloc in the measured region.
+namespace privateimpl_fallback {
+struct Block {
+  size_t bytes;
+  uint32_t device;
+  cudaEvent_t ready;
+  cudaStream_t last_stream = nullptr;
+  bool available = false;
+};
+struct Arena { unsigned char *base = nullptr; size_t used = 0; };
+struct Cache {
+  size_t limit = 0;
+  std::mutex mutex;
+  std::map<void *, Block> blocks;
+  std::map<uint32_t, Arena> arenas;
+  std::map<std::pair<uint32_t, size_t>, std::vector<void *>> free;
+  uint64_t hits = 0, slices = 0, releases = 0;
+  size_t live_bytes = 0, peak_live_bytes = 0;
+  Cache() {
+    const auto *value = std::getenv("PRIVATEIMPL_TFHE_ARENA_MB");
+    if (value) {
+      char *end = nullptr;
+      const auto megabytes = std::strtoull(value, &end, 10);
+      if (end == value || *end || megabytes > 32768)
+        PANIC("PRIVATEIMPL_TFHE_ARENA_MB must be an integer in [0, 32768]");
+      limit = megabytes * size_t(1024 * 1024);
+    }
+  }
+  ~Cache() {
+    if (!limit) return;
+    size_t bytes = 0, available = 0;
+    for (const auto &[device, arena] : arenas) bytes += arena.used;
+    for (const auto &[ptr, block] : blocks)
+      if (block.available) available += block.bytes;
+    std::fprintf(stderr,
+        "TFHE_ARENA cuda_malloc_calls=%zu reused_slices=%llu fresh_slices=%llu "
+        "releases=%llu reserved_bytes=%zu carved_bytes=%zu "
+        "peak_live_bytes=%zu available_bytes=%zu\n",
+        arenas.size(), (unsigned long long)hits, (unsigned long long)slices,
+        (unsigned long long)releases, arenas.size() * limit, bytes,
+        peak_live_bytes, available);
+  }
+};
+inline Cache &cache() { static Cache value; return value; }
+
+inline void *allocate(size_t bytes, cudaStream_t stream, uint32_t device) {
+  auto &c = cache();
+  if (!c.limit || !bytes) {
+    void *ptr = nullptr;
+    check_cuda_error(cudaMalloc(&ptr, bytes));
+    return ptr;
+  }
+  std::unique_lock lock(c.mutex);
+  // Slice alignment matches cudaMalloc's minimum device alignment.
+  if (bytes > c.limit) PANIC("TFHE arena request exceeds its capacity");
+  bytes = (bytes + 255) & ~size_t(255);
+  auto &arena = c.arenas[device];
+  if (!arena.base)
+    check_cuda_error(cudaMalloc((void **)&arena.base, c.limit));
+  auto &free = c.free[{device, bytes}];
+  // Prefer the same stream or an already completed release. A pending block
+  // from another stream is used only at the cap, avoiding artificial chains
+  // between independent workers while uncarved arena storage is available.
+  size_t choice = free.size();
+  for (size_t i = 0; i < free.size(); ++i) {
+    auto &block = c.blocks.at(free[i]);
+    const auto status = cudaEventQuery(block.ready);
+    if (status != cudaSuccess && status != cudaErrorNotReady)
+      check_cuda_error(status);
+    if (block.last_stream == stream || status == cudaSuccess) {
+      choice = i;
+      break;
+    }
+  }
+  if (choice == free.size() && !free.empty() &&
+      bytes > c.limit - arena.used) choice = 0;
+  if (choice < free.size()) {
+    auto *ptr = free[choice];
+    free[choice] = free.back();
+    free.pop_back();
+    auto &block = c.blocks.at(ptr);
+    // Always wait, even for an equal stream handle: a destroyed stream's
+    // numerical handle can be recycled for a new stream.
+    check_cuda_error(cudaStreamWaitEvent(stream, block.ready, 0));
+    block.available = false;
+    ++c.hits;
+    c.live_bytes += bytes;
+    c.peak_live_bytes = std::max(c.peak_live_bytes, c.live_bytes);
+    return ptr;
+  }
+  if (bytes > c.limit - arena.used)
+    PANIC("TFHE contiguous arena exhausted; increase PRIVATEIMPL_TFHE_ARENA_MB");
+  void *ptr = arena.base + arena.used;
+  arena.used += bytes;
+  ++c.slices;
+  c.live_bytes += bytes;
+  c.peak_live_bytes = std::max(c.peak_live_bytes, c.live_bytes);
+  cudaEvent_t ready;
+  check_cuda_error(cudaEventCreateWithFlags(&ready, cudaEventDisableTiming));
+  c.blocks.emplace(ptr, Block{bytes, device, ready});
+  return ptr;
+}
+
+inline bool release(void *ptr, cudaStream_t stream, uint32_t device,
+                    bool synchronous = false) {
+  auto &c = cache();
+  if (!c.limit || !ptr) return false;
+  std::lock_guard lock(c.mutex);
+  const auto found = c.blocks.find(ptr);
+  if (found == c.blocks.end()) return false;
+  auto &block = found->second;
+  if (block.device != device || block.available)
+    PANIC("Invalid fallback-cache release");
+  // Preserve cuda_drop's synchronous contract. The async path uses the same
+  // last-use ordering contract as the upstream cudaFreeAsync implementation.
+  if (synchronous) check_cuda_error(cudaDeviceSynchronize());
+  check_cuda_error(cudaEventRecord(block.ready, stream));
+  block.last_stream = stream;
+  block.available = true;
+  c.live_bytes -= block.bytes;
+  c.free[{device, block.bytes}].push_back(ptr);
+  ++c.releases;
+  return true;
+}
+} // namespace privateimpl_fallback
