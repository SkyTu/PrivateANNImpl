 namespace rngongpu
 {
+    namespace
+    {
+        __host__ Data64* allocate_random_buffer(size_t bytes,
+                                               cudaStream_t stream)
+        {
+            int device = 0;
+            int memory_pools_supported = 0;
+            RNGONGPU_CUDA_CHECK(cudaGetDevice(&device));
+            RNGONGPU_CUDA_CHECK(cudaDeviceGetAttribute(
+                &memory_pools_supported, cudaDevAttrMemoryPoolsSupported,
+                device));
+
+            // Some vGPU configurations do not support stream-ordered allocation.
+            // Both paths allocate device memory. Callers synchronize the stream
+            // before cudaFree, which is required for the asynchronous path too.
+            Data64* pointer = nullptr;
+            if (memory_pools_supported)
+            {
+                RNGONGPU_CUDA_CHECK(cudaMallocAsync(&pointer, bytes, stream));
+            }
+            else
+            {
+                RNGONGPU_CUDA_CHECK(cudaMalloc(&pointer, bytes));
+            }
+            return pointer;
+        }
+    } // namespace
